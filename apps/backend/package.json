{
  "name": "@envioya/backend",
  "version": "1.0.0",
  "description": "Backend API en NestJS para EnvíoYa",
  "private": true,
  "scripts": {
    "prebuild": "npm run build --prefix ../../packages/shared",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "prestart": "npm run build --prefix ../../packages/shared",
    "start": "nest start",
    "prestart:dev": "npm run build --prefix ../../packages/shared",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "pretest": "npm run build",
    "test": "node --test tests/integration/*.test.js tests/unit/*.test.js",
    "db:verify": "node scripts/verify-db.js",
    "predb:seed": "npm run build",
    "db:seed": "node scripts/seed-users.js",
    "predb:seed:tarifa": "npm run build",
    "db:seed:tarifa": "node scripts/seed-tarifa.js"
  },
  "dependencies": {
    "@envioya/shared": "*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "mongodb": "^6.12.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "typescript": "^5.7.2"
  }
}
