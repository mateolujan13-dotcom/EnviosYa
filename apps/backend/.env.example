# Configuración del backend de EnvíoYa (desarrollo local)
# Copiar con: copy apps\backend\.env.example apps\backend\.env
#
# Valores seguros para desarrollo. En producción definí JWT_SECRET propio
# y cambiá las contraseñas del seed. Nunca commitees el .env real.

# Base de datos (TP9)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=envioya

# Servidor HTTP
PORT=3000
FRONTEND_URL=http://localhost:5173

# Entorno: "development" o "production" (en production la cookie pasa a Secure)
NODE_ENV=development

# JWT en cookie envioya_session (httpOnly, SameSite=Lax)
# En producción es OBLIGATORIO definir JWT_SECRET con un valor propio.
JWT_SECRET=change-me-with-a-long-random-value
JWT_EXPIRES_IN=24h
JWT_REMEMBER_EXPIRES_IN=7d

# Contraseñas del seed de operadores/admin (opcional)
# Por defecto: Admin1234! y Operador1234!  (solo desarrollo)
SEED_ADMIN_PASSWORD=Admin1234!
SEED_OPERADOR_PASSWORD=Operador1234!
